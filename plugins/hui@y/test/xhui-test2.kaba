use hui

class Window extends hui.Window
	func __init__()
		super.__init__("test", 800, 600)
		from_source("
Window win 'bla'
	Grid ? ''
		Button b 'Test' noexpandy
		---|
		Button b2 'Test' noexpandy
		---|
		DrawingArea area '' expandy height=300
")
		event("b", func() print("hi"))
		event_x("area", "hui:draw", on_draw)
		event_x("area", "hui:mouse-move", on_mouse_move)

	func on_mouse_move()
		for w in get_window()
			print(w.get_mouse_position())

	func on_draw(p: hui.Painter)
		p.set_color(Color.RED)
		p.draw_rect([100,200,100,200])


func main()
	hui.fly_and_wait(new shared Window())

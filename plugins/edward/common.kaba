use os
use obs

let MAX_TEXTURES = 8

struct ivec2
	var x, y: i32
struct ivec3
	var x, y, z: i32
struct ivec4
	var x, y, z, w: i32
struct vec4
	var x, y, z, w: f32


enum extern DataType
	MODEL
	MATERIAL
	WORLD
	TERRAIN
	TEMPLATE
	SCRIPT
	TEXTURE
	SHADER
	SOUND
	FILE
	PROJECT


class extern Data as obs.Node
	var filename: os.Path
	var file_time: i32
	var type: DataType
	var out_changed: obs.Source
	func extern mut __init__()
	func extern virtual mut __delete__()
	func extern virtual mut reset()
	func extern mut reset_history()
	func extern mut begin_action(name: string)
	func extern mut end_action()
	func extern mut undo()
	func extern mut redo()
	func extern undoable() -> bool
	func extern redoable() -> bool




#let TransparencyModeDefault = -1
#let TransparencyModeNone = 0
#let TransparencyModeFunctions = 1
#let TransparencyModeColorKeyHard = 2
#let TransparencyModeColorKeySmooth = 3
#let TransparencyModeFactor = 4


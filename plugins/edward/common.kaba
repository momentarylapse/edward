use os
use obs

let MAX_TEXTURES = 8

struct ivec2
	var x, y: i32
struct ivec3
	var x, y, z: i32
struct ivec4
	var x, y, z, w: i32
struct vec4
	var x, y, z, w: f32


enum extern DataType
	MODEL
	MATERIAL
	WORLD
	TERRAIN
	TEMPLATE
	SCRIPT
	TEXTURE
	SHADER
	SOUND
	FILE
	PROJECT


class extern Data as obs.Node
	var filename: os.Path
	var file_time: i32
	var type: DataType
	var out_changed: obs.Source
	func extern begin_action(name: string)
	func extern end_action()




#let TransparencyModeDefault = -1
#let TransparencyModeNone = 0
#let TransparencyModeFunctions = 1
#let TransparencyModeColorKeyHard = 2
#let TransparencyModeColorKeySmooth = 3
#let TransparencyModeFactor = 4


use image.Painter
use os
use obs
use async.*
use yrenderer
use yengine
use xhui
use out .common.*
use out .multiview.*
use out .world.*








class extern Mode as obs.Node
	func extern mut __init__(doc: DocumentSession&)

	var out_redraw: obs.Source

	# this or a child
	func virtual extern mut on_enter_rec()
	func virtual extern mut on_connect_events_rec()
	func virtual extern mut on_leave_rec()

	# this exactly
	func virtual extern mut on_enter()
	func virtual extern mut on_connect_events()
	func virtual extern mut on_leave()

	func virtual extern mut on_command(id: string)
	#func virtual extern mut on_set_menu()
	func virtual extern mut on_update_menu()

	func virtual extern mut on_mouse_move(m: vec2, d: vec2)
	func virtual extern mut on_mouse_leave(m: vec2)
	func virtual extern mut on_left_button_down(m: vec2)
	func virtual extern mut on_left_button_up(m: vec2)
	func virtual extern mut on_key_down(key: i32)
	func virtual extern mut on_prepare_scene(p: yrenderer.RenderParams)
	func virtual extern mut on_draw_background(p: yrenderer.RenderParams, out rvd: yrenderer.RenderViewData)
	func virtual extern mut on_draw_win(p: yrenderer.RenderParams, out win: MultiViewWindow)
	func virtual extern mut on_draw_shadow(p: yrenderer.RenderParams, out rvd: yrenderer.RenderViewData)
	func virtual extern mut on_draw_post(out p: Painter)
	func virtual extern get_parent() -> Mode*
#	func extern get_root() -> Mode*
	func extern is_ancestor_of(m: Mode&) -> bool

 	func extern draw_info(out p: Painter, msg: string)

	var menu_id: string
	var toolbar_id: string

	var doc: DocumentSession&
	var session: Session&
	var multi_view: MultiView*
	var data: Data& # override!

	func virtual extern get_filename() -> os.Path
	func virtual extern is_save_state() -> bool
	func virtual extern is_undoable() -> bool
	func virtual extern is_redoable() -> bool

	var dialog: shared[xhui.Panel]
#	xhui::Panel* overlay_panel = nullptr;
	func extern set_overlay_panel(p: shared[xhui.Panel])

#	xhui::Panel* side_panel = nullptr;
	func extern set_side_panel(p: shared[xhui.Panel])


class extern SubMode extends Mode
	var parent: Mode* # override!

	func extern mut __init__(parent: Mode&)

	func override extern on_command(id: string)
	func override extern on_update_menu()
	func override extern on_connect_events_rec()

	func override extern on_prepare_scene(p: yrenderer.RenderParams)
	func override extern on_draw_background(p: yrenderer.RenderParams, out rvd: yrenderer.RenderViewData)
	func override extern on_draw_win(p: yrenderer.RenderParams, out win: MultiViewWindow)
	func override extern on_draw_shadow(p: yrenderer.RenderParams, out rvd: yrenderer.RenderViewData)

	func override extern get_parent() -> Mode*

	func extern request_mode_end()



class FloatDialog
	func extern static ask(parent: xhui.Panel, question: string, f: f32) -> future[f32]

struct IntPair
	var a, b: i32

class IntPairDialog
	func extern static ask(parent: xhui.Panel, question: string, a: i32, b: i32) -> future[IntPair]


class extern ResourceManager #extends yengine.ResourceManager
	var map_dir: os.Path
	func extern is_from_file(t: yengine.Terrain*) -> bool
	func extern is_from_file(t: yrenderer.Material*) -> bool
	func extern filename(t: yengine.Terrain*) -> os.Path
	func extern filename(t: yrenderer.Material*) -> os.Path


class extern DrawingHelper
#	let COLOR_X = Color(0.9, 0.6, 0.1, 1).srgb_to_linear()
	let COLOR_X = Color.WHITE
	let LINE_THIN = 2.0


struct extern ComplexPath
	var complete: os.Path
	var relative: os.Path
	var simple: os.Path #/relative_no_extension
	var type: DataType


class extern Storage
	func extern load(filename: os.Path, data: Data&, deep=true) -> bool
	func extern save(filename: os.Path, data: Data&) -> bool

	func extern auto_save(data: Data&) -> future[void]
	func extern open(data: Data&) -> future[void]
	func extern save_as(data: Data&) -> future[void]
	func extern file_dialog(type: DataType, save: bool, force_in_root_dir=true) -> future[ComplexPath]


class extern Session
	var ctx: yrenderer.Context&
	var resource_manager: ResourceManager&
	var drawing_helper: DrawingHelper&
	var line_helper: yrenderer.LineHelper&
	var storage: Storage&
	var win: xhui.Window&

	func extern info(message: string)
	func extern warning(message: string)
	func extern error(message: string)



class extern DocumentSession
	var session: Session&
	func extern set_mode(mode: Mode&)


var extern cur_session: Session&
